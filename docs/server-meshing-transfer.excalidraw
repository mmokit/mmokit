    {
      "type": "text",
      "id": "ev_code_left",
      "x": 175, "y": 1460,
      "width": 1220, "height": 290,
      "text": "message CellTransfer {\n  uint64            request_id    = 1;\n  CellTransferKind  kind          = 2;   // SPLIT | MERGE | MIGRATE\n  string            src_cell_id   = 3;\n  string            dest_cell_id  = 4;\n  string            dest_host_id  = 5;   // \"\" = colocated (loopback)\n  repeated bytes    entity_blobs  = 6;   // serialized by src executor\n  repeated bytes    session_blobs = 7;   // docked + in-flight players\n}\n\nmessage CellTransferReady {\n  uint64  request_id   = 1;\n  string  dest_cell_id = 2;\n  string  host_id      = 3;\n}",
      "originalText": "message CellTransfer {\n  uint64            request_id    = 1;\n  CellTransferKind  kind          = 2;   // SPLIT | MERGE | MIGRATE\n  string            src_cell_id   = 3;\n  string            dest_cell_id  = 4;\n  string            dest_host_id  = 5;   // \"\" = colocated (loopback)\n  repeated bytes    entity_blobs  = 6;   // serialized by src executor\n  repeated bytes    session_blobs = 7;   // docked + in-flight players\n}\n\nmessage CellTransferReady {\n  uint64  request_id   = 1;\n  string  dest_cell_id = 2;\n  string  host_id      = 3;\n}",
      "fontSize": 14, "fontFamily": 3,
      "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#22c55e", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 500005, "version": 1, "versionNonce": 500006,
      "isDeleted": false, "groupIds": [], "boundElements": null,
      "link": null, "locked": false, "containerId": null, "lineHeight": 1.35
    },
    {
      "type": "text",
      "id": "ev_code_right",
      "x": 1440, "y": 1460,
      "width": 800, "height": 185,
      "text": "enum CellTransferKind {\n  CELL_TRANSFER_UNSPECIFIED = 0;\n  CELL_TRANSFER_SPLIT       = 1;   // quadtree child emission\n  CELL_TRANSFER_MERGE       = 2;   // sibling consolidation\n  CELL_TRANSFER_MIGRATE     = 3;   // cross-host cell handoff\n}",
      "originalText": "enum CellTransferKind {\n  CELL_TRANSFER_UNSPECIFIED = 0;\n  CELL_TRANSFER_SPLIT       = 1;   // quadtree child emission\n  CELL_TRANSFER_MERGE       = 2;   // sibling consolidation\n  CELL_TRANSFER_MIGRATE     = 3;   // cross-host cell handoff\n}",
      "fontSize": 14, "fontFamily": 3,
      "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#22c55e", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
