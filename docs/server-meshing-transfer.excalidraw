    {"type": "text", "id": "tl_step1_body", "x": 65, "y": 1260, "width": 270, "height": 80, "text": "Orchestrator kicks off\nBeginSplit /\nBeginMerge /\nBeginMigrate", "originalText": "Orchestrator kicks off\nBeginSplit /\nBeginMerge /\nBeginMigrate", "fontSize": 13, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 403001, "version": 1, "versionNonce": 403002, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.3},
    {"type": "text", "id": "tl_step2_body", "x": 405, "y": 1260, "width": 270, "height": 80, "text": "CellTransfer cmd → src host\nfn call (all-in-one) /\nMeshControl gRPC (distributed)", "originalText": "CellTransfer cmd → src host\nfn call (all-in-one) /\nMeshControl gRPC (distributed)", "fontSize": 13, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 403003, "version": 1, "versionNonce": 403004, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.3},
    {"type": "text", "id": "tl_step3_body", "x": 745, "y": 1260, "width": 270, "height": 80, "text": "Executor drains entities\nand sessions from\nCell A per transfer kind", "originalText": "Executor drains entities\nand sessions from\nCell A per transfer kind", "fontSize": 13, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 403005, "version": 1, "versionNonce": 403006, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.3},
    {"type": "text", "id": "tl_step4_body", "x": 1085, "y": 1260, "width": 270, "height": 80, "text": "entity + session blobs\ncell.Inbox (all-in-one) /\nMeshData bidi (distributed)", "originalText": "entity + session blobs\ncell.Inbox (all-in-one) /\nMeshData bidi (distributed)", "fontSize": 13, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 403007, "version": 1, "versionNonce": 403008, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.3},
    {"type": "text", "id": "tl_step5_body", "x": 1425, "y": 1260, "width": 270, "height": 80, "text": "Dest cell spawns entities\nresumes sessions\nacks CellTransferReady", "originalText": "Dest cell spawns entities\nresumes sessions\nacks CellTransferReady", "fontSize": 13, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 403009, "version": 1, "versionNonce": 403010, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.3},
    {"type": "text", "id": "tl_step6_body", "x": 1765, "y": 1260, "width": 270, "height": 80, "text": "Coord aggregates Ready\natomic topology swap\nunder ownership lock", "originalText": "Coord aggregates Ready\natomic topology swap\nunder ownership lock", "fontSize": 13, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 403011, "version": 1, "versionNonce": 403012, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.3},
    {"type": "text", "id": "tl_step7_body", "x": 2105, "y": 1260, "width": 270, "height": 80, "text": "UpstreamSwitch → gateway\nsession epoch bump\nPeerList broadcast → all", "originalText": "UpstreamSwitch → gateway\nsession epoch bump\nPeerList broadcast → all", "fontSize": 13, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 403013, "version": 1, "versionNonce": 403014, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.3},
