    {
      "type": "text",
      "id": "title_tagline",
      "x": 120, "y": 115,
      "width": 1300, "height": 32,
      "text": "A reusable 2D MMO server engine in Go — server meshing, ECS, auto-generated typed clients",
      "originalText": "A reusable 2D MMO server engine in Go — server meshing, ECS, auto-generated typed clients",
      "fontSize": 22, "fontFamily": 3,
      "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#3b82f6",
      "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100, "angle": 0,
