    },
    {
      "type": "text",
      "id": "s2_subheading",
      "x": 120, "y": 250,
      "width": 1700, "height": 22,
      "text": "One process (--mode=all) for dev; split into coordinator / host / gateway processes for horizontal scale. Same code either way.",
