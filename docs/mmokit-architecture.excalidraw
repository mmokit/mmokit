    {
      "type": "text",
      "id": "s2_heading",
      "x": 120, "y": 215,
      "width": 1200, "height": 32,
      "text": "1.  Distributed by design — roles compose",
      "originalText": "1.  Distributed by design — roles compose",
      "fontSize": 24, "fontFamily": 3,
      "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#1e40af",
