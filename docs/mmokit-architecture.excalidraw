      "isDeleted": false, "groupIds": [], "boundElements": null,
      "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text",
      "id": "title_subtag",
      "x": 120, "y": 152,
      "width": 1500, "height": 22,
      "text": "Plug in your game; get distributed hosts, dynamic cells, AoI replication, and a generated SDK out of the box.",
      "originalText": "Plug in your game; get distributed hosts, dynamic cells, AoI replication, and a generated SDK out of the box.",
      "fontSize": 16, "fontFamily": 3,
