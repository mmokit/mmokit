root := `git rev-parse --show-toplevel`
bin  := root + "/bin/4node-basic"

# defaults shared across the 4-process recipes — override on the command line
control_addr  := "localhost:9100"
control_listen := ":9100"
gateway_port  := "8080"
host_a_id     := "test-node-0"
host_b_id     := "test-node-3"
gateway_id    := "gw-1"

# Postgres URL for the demo. Uses its own database (mmo_4node) so it
# doesn't share state with the space-game's `mmo` database. The
# database is created on first `just db-up` via db-init/. Override
# via the POSTGRES_URL env var.
postgres_url  := env("POSTGRES_URL", "postgres://mmo:mmo@localhost:5432/mmo_4node?sslmode=disable")

# generate typed TS client SDK
sdk:
    cd {{root}} && just client-sdk examples/4node-basic

# build the Go binary only (skip web)
build-go:
    cd {{root}} && just wasm-build
    cd {{root}} && go build -o bin/4node-basic ./examples/4node-basic

# build the web client (bun install + vite build → web/dist)
build-web:
    cd {{root}}/examples/4node-basic/web && bun install --frozen-lockfile && bun run build

# build the admin SPA — bundle lands in pkg/admin/static/dist/ for go:embed.
# Delegates to the root justfile so we only own the recipe in one place.
admin-build:
    cd {{root}} && just admin-build

# build TS SDK first, then web client + admin SPA, then Go binary. SDK runs
# first so the web client picks up any schema changes. The admin SPA is
# embedded into the Go binary via go:embed (so it must be built first); the
# game web client is NOT embedded — it's built to web/dist and served
# standalone (see `web-serve`).
build: sdk build-web admin-build build-go

# serve the built web client (web/dist) as a standalone static host on :5174.
# The client reads web/dist/config.json at boot for the backend URL.
web-serve port="5174":
    cd {{root}}/examples/4node-basic/web/dist && bunx serve . --single --listen {{port}}

# build + run: client on :5174 (bunx serve), server /ws+/auth on :8080,
# admin on :9101/admin/ (login: admin / admin, seeded only into an empty
# database — see seedDefaultOperator in pkg/admin/admin.go). The client dials
# the backend cross-origin, so the server allowlists :5174 via --cors-origins.
run: build
    #!/usr/bin/env bash
    set -euo pipefail
    # Point the standalone client's config.json at the backend on :8080 (the
    # built default is same-origin, which would be wrong on :5174).
    echo '{ "backendUrl": "http://localhost:8080" }' > "{{root}}/examples/4node-basic/web/dist/config.json"
    tmux kill-session -t 4node-web 2>/dev/null || true
    tmux new-session -d -s 4node-web -c "{{root}}/examples/4node-basic/web/dist" 'bunx serve . --single --listen 5174'
    trap 'tmux kill-session -t 4node-web 2>/dev/null' INT TERM EXIT
    cd {{root}} && ./bin/4node-basic '--postgres-url={{postgres_url}}' --cors-origins=http://localhost:5174 --dev-insecure-cookie

# The Go side no longer serves web assets; vite is the sole client asset source.
# We still rebuild the admin SPA — the game client uses HMR but the admin
# dashboard is served from the embedded go:embed bundle.
#
# UDP is off in the SERVER default and deliberately stays that way — it is
# opt-in, not unsafe: since CE-005b Tier 2 every packet is AEAD-sealed under a
# key the client draws over HTTPS, and a session is bound to a user before it
# carries a byte. Enabling it here is a local-dev convenience and does not
# change the shipped default. Override with a trailing `--udp-listen=:9001`, or
# disable with `--udp-listen=` (std flag: last occurrence wins).
# `just csharp-smoke` needs it, and also needs --dev-insecure-cookie below so
# /auth/udp-key will issue a key over plain HTTP.
#
# build Go + run with vite dev server (HMR on :5173, Go backend on :8080)
dev *ARGS: admin-build build-go
    #!/usr/bin/env bash
    set -euo pipefail
    tmux kill-session -t 4node-vite 2>/dev/null || true
    tmux new-session -d -s 4node-vite -c "{{root}}/examples/4node-basic/web" 'bun run dev'
    trap 'tmux kill-session -t 4node-vite 2>/dev/null' INT TERM EXIT
    cd {{root}} && ./bin/4node-basic '--postgres-url={{postgres_url}}' --dev-insecure-cookie --udp-listen=:9000 {{ARGS}}

# All-roles dev with the echo service enabled. Bring up Postgres first
# (`just db-up` from the repo root) — echo requires DB. Vite runs on
# :5173, Go backend on :8080.
echo-dev *ARGS: build-go
    #!/usr/bin/env bash
    set -euo pipefail
    tmux kill-session -t 4node-vite 2>/dev/null || true
    tmux new-session -d -s 4node-vite -c "{{root}}/examples/4node-basic/web" 'bun run dev'
    trap 'tmux kill-session -t 4node-vite 2>/dev/null' INT TERM EXIT
    cd {{root}} && ./bin/4node-basic --mode=all,service --services=echo,chat '--postgres-url={{postgres_url}}' --dev-insecure-cookie {{ARGS}}

# Tmux session `basic-dist` with coord + 2 nodes + gateway panes, each
# with its own interactive console. Logs mirror to log/distributed-basic
# via tmux pipe-pane (keeps the pane's TTY intact for readline). The
# gateway serves only /ws + /auth on :8080; the web client (web/dist) is
# served standalone on :5174 by a pane in this session, and the gateway
# allowlists that origin via --cors-origins so cross-origin auth works.
#
# Host IDs test-node-0 + test-node-3 are chosen because the fnv64a
# rendezvous hash produces a 2-2 cell split for the 2x2 grid; generic
# names like alpha/beta would put all 4 cells on one host.

# run 4node-basic in 4-process distributed mode (tmux)
distributed: build
    #!/usr/bin/env bash
    set -euo pipefail
    command -v tmux >/dev/null 2>&1 || { echo "tmux required: sudo apt install tmux  OR  brew install tmux"; exit 1; }
    logdir="{{root}}/log/distributed-basic"
    tmux kill-session -t basic-dist 2>/dev/null || true
    mkdir -p "$logdir"
    # Point the standalone client's config.json at the gateway on :8080 (the
    # built default is same-origin, which would be wrong on :5174).
    echo '{ "backendUrl": "http://localhost:8080" }' > "{{root}}/examples/4node-basic/web/dist/config.json"

    # Each split-window (without -d) makes the new pane active, so the
    # following pipe-pane targets it without needing explicit indices
    # (works regardless of pane-base-index). select-layout tiled after
    # each split redistributes space so the next split has room — else
    # tmux rejects "no space for new pane" on small terminals.
    # Same cluster secret on every process — see the root justfile's
    # distributed-space recipe for why this uses tmux -e.
    secret="${MMO_CLUSTER_SECRET:-dev-cluster-secret}"

    tmux new-session -d -s basic-dist -c "{{root}}" -e "MMO_CLUSTER_SECRET=$secret" \
        "{{bin}} --mode=coordinator --control-listen={{control_listen}} '--postgres-url={{postgres_url}}'"
    tmux pipe-pane -t basic-dist -o "cat > $logdir/coordinator.log"

    # UDP goes on the GATEWAY ONLY. Gateways terminate client connections;
    # hosts and the coordinator never see client traffic, and giving them the
    # same flag would just collide on :9000.
    tmux split-window -t basic-dist -c "{{root}}" -e "MMO_CLUSTER_SECRET=$secret" \
        "{{bin}} --mode=gateway,service --services=auth,chat --coordinator-addr={{control_addr}} --gateway-id={{gateway_id}} --port={{gateway_port}} '--postgres-url={{postgres_url}}' --cors-origins=http://localhost:5174 --dev-insecure-cookie --udp-listen=:9000"
    tmux pipe-pane -t basic-dist -o "cat > $logdir/gateway.log"
    tmux select-layout -t basic-dist tiled

    tmux split-window -t basic-dist -c "{{root}}" -e "MMO_CLUSTER_SECRET=$secret" \
        "{{bin}} --mode=host --coordinator-addr={{control_addr}} --host-id={{host_a_id}} '--postgres-url={{postgres_url}}'"
    tmux pipe-pane -t basic-dist -o "cat > $logdir/host-a.log"
    tmux select-layout -t basic-dist tiled

    tmux split-window -t basic-dist -c "{{root}}" -e "MMO_CLUSTER_SECRET=$secret" \
        "{{bin}} --mode=host --coordinator-addr={{control_addr}} --host-id={{host_b_id}} '--postgres-url={{postgres_url}}'"
    tmux pipe-pane -t basic-dist -o "cat > $logdir/host-b.log"
    tmux select-layout -t basic-dist tiled

    # Web client (web/dist) served standalone on :5174 — open it in a browser.
    tmux split-window -t basic-dist -c "{{root}}/examples/4node-basic/web/dist" \
        "bunx serve . --single --listen 5174"
    tmux pipe-pane -t basic-dist -o "cat > $logdir/web.log"
    tmux select-layout -t basic-dist tiled

    tmux attach-session -t basic-dist

# kill the distributed tmux session (all 4 processes)
distributed-stop:
    tmux kill-session -t basic-dist 2>/dev/null || true

# tail all distributed-basic pane logs
distributed-logs:
    tail -F {{root}}/log/distributed-basic/*.log

# remove Go binary and web build output
clean:
    rm -f {{root}}/bin/4node-basic
    rm -rf {{root}}/examples/4node-basic/web/dist
