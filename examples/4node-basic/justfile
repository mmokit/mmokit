root := `git rev-parse --show-toplevel`
bin  := root + "/bin/4node-basic"

# defaults shared across the 4-process recipes — override on the command line
control_addr  := "localhost:9100"
control_listen := ":9100"
gateway_port  := "8080"
node_a_id     := "test-node-0"
node_b_id     := "test-node-3"
gateway_id    := "gw-1"

# generate typed TS client SDK
sdk:
    cd {{root}} && just client-sdk examples/4node-basic

# build the Go binary only (skip web)
build-go:
    cd {{root}} && go build -o bin/4node-basic ./examples/4node-basic

# build the web client (bun install + vite build → web/dist)
build-web:
    cd {{root}}/examples/4node-basic/web && bun install --frozen-lockfile && bun run build

# build Go + web client for standalone serving from web/dist
build: build-go build-web

# build and run `all` preset (serves the built web/dist — no vite needed)
run: build
    cd {{root}} && ./bin/4node-basic

# build Go + run with vite dev server (HMR on :5173, Go backend on :8080)
# Disables static serving on the Go side so vite is the sole asset source.
# Uses build-go instead of build so we skip the (slow) web build — vite
# transpiles source on the fly.
dev *ARGS: build-go
    #!/usr/bin/env bash
    set -euo pipefail
    tmux kill-session -t 4node-vite 2>/dev/null || true
    tmux new-session -d -s 4node-vite -c "{{root}}/examples/4node-basic/web" 'bun run dev'
    trap 'tmux kill-session -t 4node-vite 2>/dev/null' INT TERM EXIT
    cd {{root}} && ./bin/4node-basic --web-dir=disabled {{ARGS}}

# ── 4-process multi-binary mode ─────────────────────────────────────────
# Each recipe builds the binary then starts ONE process in the foreground
# with sane defaults. Run each in a separate terminal:
#
#   terminal 1: just dev-coord
#   terminal 2: just dev-node-a
#   terminal 3: just dev-node-b
#   terminal 4: just dev-gateway
#
# Then point a browser at http://localhost:8080. The gateway serves the
# embedded web/dist. Override defaults via positional args, e.g.:
#
#   just dev-gateway --gateway-id=gw-2 --port=8081
#
# The host IDs `test-node-0` + `test-node-3` are chosen because the
# fnv64a rendezvous hash deterministically produces a 2-2 cell split for
# the 2x2 grid; generic names like "alpha"/"beta" would put all 4 cells
# on one host.

# pure coordinator: control plane only, no WebSocket listener
dev-coord *ARGS: build-go
    cd {{root}} && {{bin}} \
        --mode=coordinator \
        --control-listen={{control_listen}} \
        {{ARGS}}

# node worker A — registers with coord, hosts assigned cells
dev-node-a *ARGS: build-go
    cd {{root}} && {{bin}} \
        --mode=node \
        --coordinator-addr={{control_addr}} \
        --host-id={{node_a_id}} \
        {{ARGS}}

# node worker B — registers with coord, hosts assigned cells
dev-node-b *ARGS: build-go
    cd {{root}} && {{bin}} \
        --mode=node \
        --coordinator-addr={{control_addr}} \
        --host-id={{node_b_id}} \
        {{ARGS}}

# standalone gateway — terminates WebSockets, proxies via MeshData,
# serves embedded web/dist on :8080
dev-gateway *ARGS: build
    cd {{root}} && {{bin}} \
        --mode=gateway \
        --coordinator-addr={{control_addr}} \
        --gateway-id={{gateway_id}} \
        --port={{gateway_port}} \
        {{ARGS}}

# coordinator + embedded gateway in one process — control plane +
# WebSocket listener + embedded web/dist on :8080. No local host — cells
# only exist once a --mode=node process attaches via MeshControl. Use
# this to reproduce the gateway↔node wire path without the split
# dev-coord + dev-gateway setup (one fewer process to manage).
#
#   terminal 1: just dev-coord-gateway
#   terminal 2: just dev-node-a
dev-coord-gateway *ARGS: build
    cd {{root}} && {{bin}} \
        --mode=coordinator,gateway \
        --control-listen={{control_listen}} \
        --gateway-id={{gateway_id}} \
        --port={{gateway_port}} \
        {{ARGS}}

# Tier 1 progressive scale-out: coordinator + local host (cells live
# in this process), control plane open for remote --mode=node joins.
# Combine with dev-node-a / dev-node-b in other terminals to attach
# more capacity. Cells stay pinned until S7 migration lands.
dev-coord-host *ARGS: build
    cd {{root}} && {{bin}} \
        --mode=coordinator,host,gateway \
        --control-listen={{control_listen}} \
        {{ARGS}}

# ── S7 distributed cell split/merge/migrate live demo ──────────────────
# Single-process all-in-one preset with 60 bot entities spawned into
# cell (0,0). The demo-tuned PartitionConfig fires an auto-split within
# ~5-10s once the bots are active, then the web client's topology
# overlay redraws to show cell (0,0) replaced by its 4 children — live,
# with no client reconnect.
#
# What to expect in the browser at http://localhost:8080:
#   1. Connect → you see the 2x2 base grid.
#   2. ~10s later → cell (0,0) splits into 4 quadrant children.
#   3. After ~60s of stable load → the 4 children may auto-merge back
#      (entity count per child drops below the 0.20 merge threshold).
#
# Override bot count, target cell, or split sustain on the command line:
#   just s7-demo --synth-bots=120 --synth-bots-cell=1,0 --split-sustain=10s
s7-demo *ARGS: build
    @echo ""
    @echo "  ┌──────────────────────────────────────────────────────────┐"
    @echo "  │  S7 demo — 60 bots will crowd cell (0,0) and trigger    │"
    @echo "  │  an auto-split within ~10s. Open http://localhost:8080  │"
    @echo "  │  in a browser and watch the topology overlay redraw.    │"
    @echo "  └──────────────────────────────────────────────────────────┘"
    @echo ""
    cd {{root}} && {{bin}} \
        --synth-bots=60 \
        --synth-bots-cell=0,0 \
        {{ARGS}}

# remove Go binary and web build output
clean:
    rm -f {{root}}/bin/4node-basic
    rm -rf {{root}}/examples/4node-basic/web/dist
