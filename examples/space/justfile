# The reference space game. Larger than the other two examples on purpose:
# it is the framework's most demanding consumer and its regression bed.
#
# Recipes that are not specific to this game — proto, fuzz, admin-*,
# csharp-*, ts-core-test, db-* — live in the repository root justfile.

root := `git rev-parse --show-toplevel`
bin  := root + "/bin/space"

# Postgres URL for the game. Uses its own database (mmo_space) so it does not
# share state with the other examples, or with the bare `mmo` database that
# `just test-pg` TRUNCATEs. Created on first `just db-up` below. Override via
# the POSTGRES_URL env var.
postgres_url := env("POSTGRES_URL", "postgres://mmo:mmo@localhost:5432/mmo_space?sslmode=disable")

# The hand-authored world manifest. Passed explicitly rather than relying on
# the --world-dir default, which resolves against the working directory:
# jsonrepo.LoadAll MkdirAll's whatever it is given, so a wrong value creates a
# stray empty manifest directory instead of failing.
world_dir := root + "/examples/space/world"

# generate the typed TS client SDK → web/sdk (delegates to the generic recipe)
sdk:
    cd {{root}} && just client-sdk examples/space

# build the web client (bun install + vite build → web/dist)
build-web:
    cd {{root}}/examples/space/web && bun install --frozen-lockfile && bun run build

# build the Go binary only
build-go:
    cd {{root}} && go build -o bin/space ./examples/space

# build the admin SPA bundle (embedded into the binary via go:embed)
admin-build:
    cd {{root}} && just admin-build

# start Postgres and ensure the mmo_space database exists (idempotent —
# db-init/ seeds it on a fresh volume, the CREATE DATABASE guard creates it on
# an already-initialized volume so you never need a `just db-reset`)
db-up:
    cd {{root}} && just db-up
    cd {{root}} && docker compose exec -T postgres sh -c 'until pg_isready -U mmo -d mmo >/dev/null 2>&1; do sleep 0.5; done'
    cd {{root}} && docker compose exec -T postgres psql -U mmo -d mmo -tc "SELECT 1 FROM pg_database WHERE datname='mmo_space'" | grep -q 1 \
        || docker compose exec -T postgres psql -U mmo -d mmo -c "CREATE DATABASE mmo_space OWNER mmo"

# SDK + web client + admin bundle + server binary
build: sdk build-web admin-build build-go

# build + run
run: db-up build
    {{bin}} --world-dir={{world_dir}} --postgres-url={{postgres_url}}

# build the load-test bot client
botclient:
    cd {{root}} && go build -o bin/space-botclient ./examples/space/botclient

# serve the built web client (web/dist) as a standalone static host.
# Run alongside `just run` (server on :8080) for a no-vite build+run setup.
# Pass the matching origin to the server: --cors-origins=http://localhost:5174
web-serve port="5174":
    cd {{root}}/examples/space/web && bunx serve dist --single --listen {{port}}

# regenerate the Go→TS ship-dynamics parity fixture by driving the REAL
# ShipDynamicsSystem + PhysicsSystem. Consumed by
# web/src/__tests__/prediction-golden.test.ts, which is what fails when
# internal/game/system_ship_dynamics.go changes without web/src/prediction.ts.
shipdyn-golden:
    cd {{root}} && go test ./examples/space/internal/game/ -run TestShipDynamicsGolden -count=1 -update-shipdyn-golden -v

# client-prediction, reconciliation and interpolation suites for this game's
# web client. The shared codec core is covered by the root's ts-core-test.
web-test:
    cd {{root}} && bun test examples/space/web/src/__tests__/

# enforce the no-ark-in-game invariant for this game's game layer
lint-no-ark:
    cd {{root}} && ./scripts/no_ark_in_game.sh examples/space/internal/game

# Postgres integration tests for this game's persistence layer.
# -p 1 serializes: the pgtest suites share a database and TRUNCATE in setup.
test-pg:
    cd {{root}} && POSTGRES_URL={{postgres_url}} \
        go test -p 1 -count=1 -tags=pgtest ./examples/space/internal/persist/...

# unit coverage for the distributed-commands + entity-teleport work.
# End-to-end verification lives in examples/4node-basic's e2e test and the
# manual `just distributed` console below.
smoke-commands:
    cd {{root}} && go test -v ./pkg/universe/ \
        -run "TestEntity|TestPlayer|TestResolve|TestPickDBHost|TestMoveEntityTo|TestHandoffDriver_AcceptsNonNeighbor|TestHandoffDriver_BypassCooldown"
    cd {{root}} && go test -v ./pkg/cmdsys/ -run "TestRouteKindString_PlayerHomeOrOwner|TestLocalContext_AcceptsLocalProcess"
    cd {{root}} && go test -v . -run "TestMmokitFacade_ExportsMoveEntityAPI"
    cd {{root}} && go test -v ./examples/space/internal/game/ -run "TestPlayerDataAccessor_RoundTrip|TestRepoLocator_HitAndMiss"

# diagnostic — sample the server's /probe-ws heartbeat endpoint to isolate
# whether bursty WebSocket delivery is a server / network / browser issue.
# Requires `just dev` to be running. Args are POSITIONAL.
probe duration="30" host="localhost:8080":
    cd {{root}} && bun run diagnostics/probe.ts --host={{host}} --duration={{duration}}

probe-json duration="30" host="localhost:8080":
    cd {{root}} && bun run diagnostics/probe.ts --host={{host}} --duration={{duration}} --json

# build + run server & the vite dev server for this example's web client
# UDP is off in the SERVER default (CE-005b Tier 1) and deliberately stays
# that way — packets are unauthenticated and unencrypted. Enabling it here is
# an explicit local-dev choice on loopback, and does not change the shipped
# default. Override with a trailing `--udp-listen=:9001`, or disable with
# `--udp-listen=` (std flag: last occurrence wins).
#
# The bind is the WILDCARD ':9000' on purpose: a wildcard bind opens an IPv6
# socket that accepts IPv4 peers 4-in-6, while '127.0.0.1:9000' rejects them.
dev *ARGS: db-up build
    #!/usr/bin/env bash
    set -euo pipefail
    tmux kill-session -t space-vite 2>/dev/null || true
    tmux new-session -d -s space-vite -c "{{ root }}/examples/space/web" 'bun run dev'
    trap 'tmux kill-session -t space-vite 2>/dev/null' INT TERM EXIT
    {{bin}} --dev-insecure-cookie --udp-listen=:9000 \
        --world-dir={{world_dir}} --postgres-url={{postgres_url}} {{ARGS}}

# Tmux session `space-dist` with coord + 3 nodes + gateway panes, each
# with its own interactive console. Logs mirror to log/distributed-space
# via tmux pipe-pane (keeps the pane's TTY intact for readline).
# Gateway serves only /ws + /auth on :8080; the web client (web/dist) is
# served on :5174 by a detached `space-web` session this recipe starts, with
# its config.json auto-pointed at :8080 and the gateway allowlisting :5174 via
# --cors-origins. Open http://localhost:5174 in a browser.

# run the space game in 5-process distributed mode (tmux)
distributed: db-up build
    #!/usr/bin/env bash
    set -euo pipefail
    command -v tmux >/dev/null 2>&1 || { echo "tmux required: sudo apt install tmux  OR  brew install tmux"; exit 1; }
    root="{{ root }}"
    bin="{{ bin }}"
    coord_addr="localhost:9100"
    logdir="$root/log/space-distributed"
    tmux kill-session -t space-dist 2>/dev/null || true
    mkdir -p "$logdir"

    # Serve the web client standalone on :5174. Point its config.json at the
    # gateway on :8080 (the built default is same-origin, which would be wrong
    # here since the page is on :5174). Runs in a detached session so the
    # 5-pane process layout below stays intact; killed on exit.
    echo '{ "backendUrl": "http://localhost:8080" }' > "$root/examples/space/web/dist/config.json"
    tmux kill-session -t space-web 2>/dev/null || true
    tmux new-session -d -s space-web -c "$root/examples/space/web/dist" 'bunx serve . --single --listen 5174'
    trap 'tmux kill-session -t space-web 2>/dev/null' EXIT

    # Layout: coordinator as a wide bottom pane (30% of window height),
    # workers + gateway as a thin equal-width row above it.
    #
    #   +------+------+------+------+
    #   | h-0  | h-1  | h-2  |  gw  |   70%  (worker row)
    #   +------+------+------+------+
    #   |       coordinator         |   30%  (admin + fan-out target)
    #   +---------------------------+
    #
    # Create coordinator first (it becomes the bottom pane via -v -b on
    # the first split). Each subsequent -h split targets the preceding
    # pane by index and uses -l PCT to size the NEW pane as a fraction
    # of the SPLIT target — yielding four ~equal columns up top without
    # needing a window-wide layout that would also resize the bottom.
    # Every process of a multi-process cluster must present the same cluster
    # secret. Without it the mesh still forms, but each process warns that its
    # peers are unauthenticated (CE-006 criterion 7). Exported per-pane via
    # tmux -e rather than a bare `export`, which does not reliably reach panes
    # when a tmux server is already running.
    secret="${MMO_CLUSTER_SECRET:-dev-cluster-secret}"

    tmux new-session -d -s space-dist -c "$root" -e "MMO_CLUSTER_SECRET=$secret" \
        "$bin --mode=coordinator --control-listen=:9100 --world-dir={{ world_dir }} '--postgres-url={{ postgres_url }}'"
    tmux pipe-pane -t space-dist -o "cat > $logdir/coordinator.log"

    tmux split-window -t space-dist -v -b -l 70% -c "$root" -e "MMO_CLUSTER_SECRET=$secret" \
        "$bin --mode=host --coordinator-addr=$coord_addr --host-id=space-host-0 --world-dir={{ world_dir }} '--postgres-url={{ postgres_url }}'"
    tmux pipe-pane -t space-dist -o "cat > $logdir/host-0.log"

    # Top pane now holds host-0; split it into four equal columns.
    tmux split-window -t space-dist -h -l 75% -c "$root" -e "MMO_CLUSTER_SECRET=$secret" \
        "$bin --mode=host --coordinator-addr=$coord_addr --host-id=space-host-1 --world-dir={{ world_dir }} '--postgres-url={{ postgres_url }}'"
    tmux pipe-pane -t space-dist -o "cat > $logdir/host-1.log"

    tmux split-window -t space-dist -h -l 66% -c "$root" -e "MMO_CLUSTER_SECRET=$secret" \
        "$bin --mode=host --coordinator-addr=$coord_addr --host-id=space-host-2 --world-dir={{ world_dir }} '--postgres-url={{ postgres_url }}'"
    tmux pipe-pane -t space-dist -o "cat > $logdir/host-2.log"

    # UDP goes on the GATEWAY ONLY. Gateways are what terminate client
    # connections; hosts and the coordinator never see client traffic, and
    # giving them the same flag would just collide on :9000.
    #
    # Gateway also runs the auth service (--mode=gateway,service) so the
    # /auth/* HTTPS endpoints mount on the gateway's HTTP listener on :8080
    # (the same listener the client's /ws + /auth requests reach). The auth kind needs Postgres,
    # hence --postgres-url. --dev-insecure-cookie keeps cookies usable
    # over plain HTTP localhost. The URL is single-quoted so zsh (tmux's
    # default-shell on this box) doesn't glob-expand the `?` in
    # `?sslmode=disable` and refuse to launch the binary.
    tmux split-window -t space-dist -h -l 50% -c "$root" -e "MMO_CLUSTER_SECRET=$secret" \
        "$bin --mode=gateway,service --services=auth --coordinator-addr=$coord_addr --gateway-id=space-gw-0 --port=8080 '--postgres-url={{ postgres_url }}' --cors-origins=http://localhost:5174 --dev-insecure-cookie --udp-listen=:9000"
    tmux pipe-pane -t space-dist -o "cat > $logdir/gateway.log"

    # Focus on the coordinator pane so the user lands at the admin prompt.
    # Use {bottom-left} (positional) rather than pane index — tmux renumbers
    # by position after splits, so the first-created pane isn't index 0.
    tmux select-pane -t 'space-dist.{bottom-left}'

    tmux attach-session -t space-dist

# kill the distributed tmux session (all 5 processes) + the web host
distributed-stop:
    tmux kill-session -t space-dist 2>/dev/null || true
    tmux kill-session -t space-web 2>/dev/null || true

# tail all distributed pane logs
distributed-logs:
    tail -F {{ root }}/log/space-distributed/*.log

