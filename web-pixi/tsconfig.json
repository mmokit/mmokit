{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@gen/engine_pb.js": ["../gen/es/enginepb/engine_pb.js"],
      "@gen/game_pb.js": ["../gen/es/gamepb/game_pb.js"]
    }
  },
  "include": ["src"]
}
